{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (free tier). Nothing Cortex logs contains message text:
  // schedule ids, purge counts, message ids, provider error objects, and
  // retrieval telemetry (SOP keys, scores, counts, config, latency — never
  // query or chunk text).
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "ai_search_namespaces": [
    { "binding": "AI_SEARCH", "namespace": "default", "remote": true }
  ],
  "r2_buckets": [
    { "binding": "SOP_BUCKET", "bucket_name": "cortex-sops", "remote": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "vars": {
    // Hard monthly cap on answered messages (~$0.005-0.01 each on Workers
    // Paid), enforced by the UsageBudget Durable Object. Raise as needed.
    "MONTHLY_MESSAGE_BUDGET": "2500",
    // AI Gateway that Workers AI calls are routed through for cost/usage
    // analytics and the dollar spend limit. Empty disables gateway routing.
    "AI_GATEWAY_ID": "cortex",
    // Retrieval settings, passed to AI Search per request (they override the
    // instance defaults). With rewrite on, a model rewrites the query before
    // search on every turn, the first included (observed through the binding
    // on 3 Sep 2026, contrary to the docs), and adds seconds of latency.
    "RETRIEVAL_QUERY_REWRITE": "on",
    // 1-50 chunks before dedupe into SOP cards; more distinct files reach
    // the ranking. The passage budget still caps what the model reads. 30
    // chosen by the 3 Sep 2026 matrix (docs/eval/2026-09-03-retrieval.md):
    // every expected SOP in the top 3, no misses; 15 missed three. Keyword
    // mode "or" was not adopted: it admits weak keyword candidates and
    // demoted the headline case; rewrite stays on because follow-up turns
    // lose the thread without it.
    "RETRIEVAL_MAX_RESULTS": "30",
    // "and" needs every word of a sentence-length question to match one
    // chunk, so in practice the keyword half returns nothing and hybrid
    // search silently degrades to vector-only in our probes; "or" lets
    // tokens like G31.84, VRI, ICD-10 hit the keyword index.
    "RETRIEVAL_KEYWORD_MATCH": "and"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      },
      {
        "class_name": "UsageBudget",
        "name": "USAGE_BUDGET"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["UsageBudget"],
      "tag": "v2"
    }
  ]
}
